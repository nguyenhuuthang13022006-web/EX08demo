@model Lesson08DF.Models.Category

@{
    ViewData["Title"] = "Xác nhận xóa Loại sách";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="card-title mb-0">Xác nhận xóa Loại sách</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa loại sách này không? Thao tác này không thể hoàn tác!
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.CategoryId)</dt>
                        <dd class="col-sm-8 fw-bold">@Model.CategoryId</dd>

                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.CategoryName)</dt>
                        <dd class="col-sm-8 text-primary fw-semibold">@Html.DisplayFor(model => model.CategoryName)</dd>

                        <dt class="col-sm-4 text-muted">Số lượng sách liên kết</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.Books.Any() ? "bg-warning text-dark" : "bg-secondary")">
                                @Model.Books.Count quyển
                            </span>
                        </dd>
                    </dl>

                    @if (Model.Books.Any())
                    {
                        <div class="alert alert-danger mt-2">
                            <strong>Lưu ý:</strong> Thể loại này hiện đang có dữ liệu sách liên kết. Hệ thống sẽ chặn thao tác xóa để đảm bảo toàn vẹn dữ liệu.
                        </div>
                    }

                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="CategoryId" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">&larr; Quay lại danh sách</a>
                            <button type="submit" class="btn btn-danger">
                                Xác nhận xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
