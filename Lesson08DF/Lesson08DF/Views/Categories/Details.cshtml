@model Lesson08DF.Models.Category

@{
    ViewData["Title"] = "Chi tiết Loại sách";
}

<div class="container py-3">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Chi tiết Loại sách: @Model.CategoryName</h5>
            <span class="badge bg-light text-dark">ID: #@Model.CategoryId</span>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.CategoryId)</dt>
                <dd class="col-sm-9 fw-bold">@Model.CategoryId</dd>

                <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.CategoryName)</dt>
                <dd class="col-sm-9 text-primary fw-semibold">@Html.DisplayFor(model => model.CategoryName)</dd>

                <dt class="col-sm-3 text-muted">Tổng số sách</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-primary">@Model.Books.Count quyển sách</span>
                </dd>
            </dl>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">&larr; Quay lại danh sách</a>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-warning">Sửa</a>
                <a asp-action="Delete" asp-route-id="@Model.CategoryId" class="btn btn-danger">Xóa</a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h6 class="mb-0">Danh sách sách thuộc loại này (@Model.Books.Count quyển)</h6>
        </div>
        <div class="card-body p-0">
            @if (!Model.Books.Any())
            {
                <div class="p-3 text-muted text-center">Chưa có cuốn sách nào thuộc thể loại này.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã sách</th>
                                <th>Tiêu đề</th>
                                <th>Tác giả</th>
                                <th>Giá</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var book in Model.Books)
                            {
                                <tr>
                                    <td>@book.BookId</td>
                                    <td>@book.Title</td>
                                    <td>@book.Author</td>
                                    <td>@(book.Price.HasValue ? string.Format("{0:N0} đ", book.Price) : "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
